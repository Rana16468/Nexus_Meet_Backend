# HTTP + Socket.io
PORT=4000
CLIENT_ORIGIN=http://localhost:8080

# MongoDB Atlas (cloud)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexusmeet?retryWrites=true&w=majority

# mediasoup
# On Windows 11 keep 127.0.0.1 for pure-local use.
# For LAN access set ANNOUNCED_IP to the machine's IPv4 (ipconfig -> IPv4 Address).
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100
MEDIASOUP_WORKERS=2

# Capacity
MAX_PARTICIPANTS=40
